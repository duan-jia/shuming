MCP_HOST=127.0.0.1
MCP_PORT=3100
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
RAG_API_BASE_URL=http://127.0.0.1:9006
RAG_TIMEOUT_MS=10000
# Generate tokenSha256 with: printf '%s' 'agent-secret' | sha256sum
# Recommended: use a dedicated C++ service-account user. The gateway logs in and
# refreshes its tenant-bound JWT automatically. A static upstreamBearerToken is
# also supported for migration, but must be rotated before it expires.
SERVICE_PRINCIPALS_JSON=[{"name":"nanoclaw","tokenSha256":"replace-with-64-char-sha256","tenantId":1,"upstreamUsername":"mcp_nanoclaw","upstreamPassword":"replace-with-service-account-password"}]
