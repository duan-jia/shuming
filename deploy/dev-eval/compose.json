{
  "name": "shuming-dev-eval",
  "services": {
    "mysql": {
      "image": "mysql:8.4",
      "restart": "unless-stopped",
      "mem_limit": "512m",
      "environment": {
        "MYSQL_ROOT_PASSWORD": "${MYSQL_ROOT_PASSWORD:?Run manage.mjs prepare first}",
        "MYSQL_DATABASE": "llm_platform",
        "MYSQL_USER": "shuming",
        "MYSQL_PASSWORD": "${MYSQL_PASSWORD:?Run manage.mjs prepare first}"
      },
      "ports": ["127.0.0.1:23306:3306"],
      "volumes": [
        "mysql-data:/var/lib/mysql",
        "/srv/shuming-dev-eval/init.sql:/docker-entrypoint-initdb.d/001-init.sql:ro"
      ],
      "healthcheck": {
        "test": ["CMD-SHELL", "MYSQL_PWD=$${MYSQL_ROOT_PASSWORD} mysqladmin ping -h 127.0.0.1 -u root --silent"],
        "interval": "5s", "timeout": "5s", "retries": 30, "start_period": "20s"
      },
      "networks": ["dev-eval"]
    }
  },
  "volumes": {"mysql-data": {"name": "shuming-dev-eval_mysql-data"}},
  "networks": {"dev-eval": {"name": "shuming-dev-eval_network", "driver": "bridge"}}
}
