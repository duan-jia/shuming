{
  "server": {
    "port": 8080,
    "static_dir": ""
  },
  "mysql": {
    "host": "127.0.0.1",
    "port": 3306,
    "user": "root",
    "password": "",
    "database": "llm_platform",
    "pool_size": 4
  },
  "redis": {
    "host": "127.0.0.1",
    "port": 6379,
    "db": 0
  },
  "jwt": {
    "secret": "change-this-to-a-random-string-in-production",
    "expiry_seconds": 86400
  },
  "admin": {
    "username": "admin",
    "default_password": "changeme123"
  },
  "default_tenant": {
    "id": 1,
    "name": "default",
    "daily_token_quota": 100000
  },
  "inference": {
    "n_ctx": 2048,
    "n_batch": 512,
    "n_threads": 4,
    "n_gpu_layers": -1,
    "max_tokens": 512,
    "temperature": 0.7,
    "top_p": 0.9,
    "top_k": 40,
    "repeat_penalty": 1.1,
    "repeat_last_n": 64,
    "system_prompt": "You are a helpful AI assistant for lab internal use."
  },
  "rag": {
    "storage_dir": "data/rag"
  },
  "rate_limiter": {
    "rules": [
      { "action": "login",     "max_requests": 5,  "window_seconds": 60 },
      { "action": "chat",      "max_requests": 20, "window_seconds": 60 },
      { "action": "upload",    "max_requests": 10, "window_seconds": 60 },
      { "action": "documents", "max_requests": 30, "window_seconds": 60 },
      { "action": "sessions",  "max_requests": 30, "window_seconds": 60 }
    ]
  },
  "scheduler": {
    "num_workers": 2
  },
  "http_threads": 2,
  "remote_engine": {
    "endpoint": "https://api.deepseek.com/v1",
    "model": "deepseek-chat",
    "api_key": ""
  }
}
