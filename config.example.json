{
  "server": {
    "port": 8080,
    "static_dir": ""
  },
  "mysql": {
    "host": "127.0.0.1",
    "port": 3306,
    "user": "root",
    "password": "",
    "database": "llm_platform",
    "pool_size": 4
  },
  "jwt": {
    "secret": "change-this-to-a-random-string-in-production",
    "expiry_seconds": 86400
  },
  "admin": {
    "username": "admin",
    "default_password": "changeme123"
  },
  "default_tenant": {
    "id": 1,
    "name": "default",
    "daily_token_quota": 100000
  },
  "inference": {
    "n_ctx": 2048,
    "n_batch": 512,
    "n_threads": 4,
    "n_gpu_layers": -1,
    "max_tokens": 512,
    "temperature": 0.7,
    "top_p": 0.9,
    "top_k": 40,
    "repeat_penalty": 1.1,
    "repeat_last_n": 64,
    "system_prompt": "You are a helpful AI assistant for lab internal use."
  },
  "rag": {
    "storage_dir": "data/rag",
    "query_rewrite": {
      "enabled": false,
      "model": "Qwen3.8-27B",
      "timeout_seconds": 10
    }
  },
  "rate_limiter": {
    "rules": [
      {
        "action": "chat",
        "max_requests": 20,
        "window_seconds": 60
      }
    ]
  },
  "scheduler": {
    "num_workers": 2
  },
  "http_threads": 2,
  "remote_engine": {
    "endpoint": "http://127.0.0.1:8010/v1",
    "model": "Qwen3.8-27B",
    "context_window_tokens": 8192,
    "api_key": "local-no-auth",
    "supports_images": false
  },
  "web_search": {
    "enabled": false,
    "endpoint": "https://api.deepseek.com/v1/tools/search",
    "api_key": "",
    "timeout_seconds": 15,
    "max_concurrency": 2,
    "ca_bundle": "/etc/ssl/certs/ca-certificates.crt",
    "fetch_endpoint": "https://api.deepseek.com/v1/tools/fetch"
  },
  "mcp": {
    "allowed_origins": [],
    "allow_user_web_search": false,
    "worker_threads": 4,
    "queue_limit": 64,
    "knowledge_requests_per_minute": 60,
    "web_requests_per_minute": 20,
    "knowledge_fetch_requests_per_minute": 30,
    "web_fetch_requests_per_minute": 20
  },
  "agent": {
    "enabled": true,
    "max_turns": 6,
    "max_total_tokens": 0,
    "timeout_seconds": 300,
    "max_tool_calls_per_turn": 4,
    "max_tool_result_bytes": 6000,
    "max_output_tokens": 0
  },
  "knowledge_fetch": {
    "pdf_directory": "data/pdfs",
    "reader_script": "scripts/read_pdf.py",
    "python": "python3",
    "public_base_url": "",
    "link_ttl_seconds": 300,
    "timeout_seconds": 20,
    "max_concurrency": 2
  },
  "auth": {
    "guest_enabled": false
  }
}
